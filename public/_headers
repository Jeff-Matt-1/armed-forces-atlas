# Cloudflare Static Assets header rules.
#
# Item photographs shipped with "max-age=0, must-revalidate", so a browser
# revalidated all 197 of them on every visit. The edge cached them, but each
# card still cost a round trip, and on a filtered or congested network enough
# of those time out that images visibly fail to appear.
#
# A day of browser cache with a week of stale-while-revalidate: a study session
# re-reads nothing, and a replaced photograph still reaches everyone within a
# day without a hard refresh. The filenames are stable slugs that occasionally
# get a new picture, so "immutable" would be wrong.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icons change only when the brand does.
/icon-*.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon*
  Cache-Control: public, max-age=604800
