# Copy to .env for development. Production values belong in .env.production,
# which Vite loads instead for `vite build` — every VITE_* value is inlined at
# build time, so a wrong one ships in the bundle rather than being fixable in
# the hosting dashboard afterwards. `bun run deploy` refuses to build if these
# are missing or still point at localhost.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Canonical origin of the deployed site, no trailing slash. Backs the absolute
# og:image URLs and the fallback for emailed auth redirects.
VITE_SITE_URL=
